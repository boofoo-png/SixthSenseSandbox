# Copy this file to .env.local and fill it in. Never commit .env.local.

# Meta app (developers.facebook.com > your app > App settings > Basic)
META_APP_ID=
META_APP_SECRET=

# Encrypts saved Instagram/Facebook access tokens. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SOCIAL_TOKEN_SECRET=

# Optional: Graph API version (defaults to v26.0)
META_GRAPH_VERSION=
